{
  "name": "vibe-coding-v2-engineering-pack",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A minimal, policy-driven Vibe Coding framework baseline for OpenCode V2.",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "start:team": "node --experimental-strip-types server/main.ts",
    "test:core": "node --experimental-strip-types --test tests/*.test.ts shared/team-contracts/*.test.ts",
    "typecheck:core": "tsc --noEmit -p tsconfig.core.json",
    "verify": "npm run test:core && npm run typecheck:core"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "5.9.3"
  }
}
