{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "runtime/core/**/*.ts",
    "shared/**/*.ts",
    "runtime/opencode/plugins/vibe-v2/setup.ts",
    "runtime/opencode/plugins/vibe-v2/host-contract.ts",
    "runtime/opencode/plugins/vibe-v2/task-control.ts",
    "runtime/opencode/plugins/vibe-v2/team/**/*.ts"
  ]
}
