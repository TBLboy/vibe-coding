{
  "description": "Optional integrations for the Vibe Coding OpenCode layer. None of them are required for Vibe core: tasks, Project Log, evidence gates and verification all work without a third-party plugin or MCP server. Selected by name through install.sh --with-plugin/--with-mcp (see --list-integrations).",
  "plugins": {
    "goal": {
      "package": "@prevalentware/opencode-goal-plugin",
      "default_installed": true,
      "pinned_spec": "@prevalentware/opencode-goal-plugin@0.1.60",
      "purpose": "Session Goal control surface (/goal, /pause_goal, /resume_goal). The global rules declare this controller, so the default install pins 0.1.60 (0.1.51 crashes against the Effect v4 that OpenCode V2 injects)."
    },
    "memory": {
      "package": "opencode-agent-memory",
      "default_installed": true,
      "purpose": "Third-party agent memory. It is the one non-Vibe plugin whose V2 build is known to load; the V1-era plugins export no V2 definition and are deliberately not shipped."
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "default_installed": true
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "default_installed": true
    },
    "document-loader": {
      "type": "local",
      "command": [
        "uvx",
        "awslabs.document-loader-mcp-server"
      ],
      "environment": {
        "FASTMCP_LOG_LEVEL": "ERROR"
      },
      "timeout": 120000,
      "default_installed": true
    },
    "github": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "environment": {
        "GITHUB_TOKEN": "{env:GITHUB_TOKEN}"
      },
      "default_installed": true
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp"
      ],
      "default_installed": true
    },
    "sequential-thinking": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "default_installed": true
    },
    "web-search": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "open-websearch"
      ],
      "environment": {
        "MODE": "stdio",
        "DEFAULT_SEARCH_ENGINE": "bing",
        "ALLOWED_SEARCH_ENGINES": "bing,baidu,duckduckgo"
      },
      "default_installed": true
    },
    "wikipedia": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "wikipedia-mcp"
      ],
      "default_installed": true
    }
  }
}
