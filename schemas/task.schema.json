{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vibe Coding V2 Task",
  "description": "The only persistent Task record. No separate Run, Evidence, or Review record exists.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "goal",
    "doneWhen",
    "policy",
    "status",
    "phase",
    "decisions",
    "verification"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "doneWhen": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "policy": {
      "enum": [
        "fast",
        "balanced",
        "strict"
      ]
    },
    "status": {
      "enum": [
        "active",
        "blocked",
        "completed",
        "cancelled"
      ]
    },
    "phase": {
      "enum": [
        "prepare",
        "implement",
        "verify",
        "review",
        "complete"
      ]
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "summary",
        "checks",
        "limitations"
      ],
      "properties": {
        "status": {
          "enum": [
            "not_run",
            "passed",
            "failed",
            "not_applicable",
            "blocked"
          ]
        },
        "summary": {
          "type": "string"
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notApplicableReason": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "not_applicable"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "notApplicableReason"
            ]
          }
        }
      ]
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verdict",
        "findings",
        "repairRounds"
      ],
      "properties": {
        "verdict": {
          "enum": [
            "pending",
            "go",
            "conditional",
            "no-go"
          ]
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "severity",
              "requirement",
              "location",
              "problem",
              "requiredChange"
            ],
            "properties": {
              "severity": {
                "enum": [
                  "critical",
                  "major",
                  "minor"
                ]
              },
              "requirement": {
                "type": "string",
                "minLength": 1
              },
              "location": {
                "type": "string",
                "minLength": 1
              },
              "problem": {
                "type": "string",
                "minLength": 1
              },
              "requiredChange": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "repairRounds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        }
      }
    },
    "blocker": {
      "type": "string",
      "minLength": 1
    },
    "cancelReason": {
      "type": "string",
      "minLength": 1
    },
    "nextAction": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "policy": {
            "const": "strict"
          }
        },
        "required": [
          "policy"
        ]
      },
      "then": {
        "properties": {
          "doneWhen": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "policy": {
            "enum": [
              "fast",
              "balanced"
            ]
          }
        },
        "required": [
          "policy"
        ]
      },
      "then": {
        "not": {
          "required": [
            "review"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "const": "review"
          }
        },
        "required": [
          "phase"
        ]
      },
      "then": {
        "required": [
          "review"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "completed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "phase": {
            "const": "complete"
          },
          "verification": {
            "properties": {
              "status": {
                "enum": [
                  "passed",
                  "not_applicable"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "policy": {
            "const": "strict"
          },
          "status": {
            "const": "completed"
          }
        },
        "required": [
          "policy",
          "status"
        ]
      },
      "then": {
        "properties": {
          "review": {
            "properties": {
              "verdict": {
                "const": "go"
              }
            }
          }
        },
        "required": [
          "review"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "blocked"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "blocker"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "cancelled"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "cancelReason"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "review": {
            "properties": {
              "verdict": {
                "enum": [
                  "conditional",
                  "no-go"
                ]
              }
            },
            "required": [
              "verdict"
            ]
          }
        },
        "required": [
          "review"
        ]
      },
      "then": {
        "properties": {
          "review": {
            "properties": {
              "findings": {
                "minItems": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "review": {
            "properties": {
              "verdict": {
                "const": "go"
              }
            },
            "required": [
              "verdict"
            ]
          }
        },
        "required": [
          "review"
        ]
      },
      "then": {
        "properties": {
          "review": {
            "properties": {
              "findings": {
                "maxItems": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "const": "complete"
          }
        },
        "required": [
          "phase"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "const": "completed"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "review": {
            "properties": {
              "verdict": {
                "const": "pending"
              }
            },
            "required": [
              "verdict"
            ]
          }
        },
        "required": [
          "review"
        ]
      },
      "then": {
        "properties": {
          "review": {
            "properties": {
              "findings": {
                "maxItems": 0
              }
            }
          }
        }
      }
    }
  ]
}
